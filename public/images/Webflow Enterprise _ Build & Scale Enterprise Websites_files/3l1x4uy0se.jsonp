740k","display_name":"4k","details":{},"container":"mp4","codec":"h264","width":3840,"height":2160,"ext":"mp4","size":80890669,"bitrate":4740,"public":true,"status":2,"progress":1.0,"metadata":{"max_bitrate":9170896,"average_bitrate":4853925,"early_max_bitrate":6173544,"av_stream_metadata":"{\"Audio\":{\"Codec ID\":\"mp4a-40-2\",\"frameRate\":43.066,\"sampleRate\":44100},\"Video\":{\"Codec ID\":\"avc1\",\"frameRate\":23.976,\"frameRateMode\":\"CFR\"}}"},"url":"https://embed-ssl.wistia.com/deliveries/d8ae0b413f167c723dd74d19c146c7235b54cb92.bin","created_at":1678210480,"segment_duration":3,"opt_vbitrate":11250},{"type":"storyboard","slug":"storyboard_2000x2260","display_name":"Storyboard","details":{},"width":2000,"height":2260,"ext":"jpg","size":4012084,"bitrate":0,"public":true,"status":2,"progress":1.0,"metadata":{"frame_count":200,"aspect_ratio":1.7777777777777777,"frame_height":113,"frame_width":200},"url":"https://embed-ssl.wistia.com/deliveries/cf8adc8ac6663e0225d2685ecbbd308419073d13.bin","created_at":1678210480},{"type":"still_image","slug":"still_image_1600x900","display_name":"Thumbnail Image","details":{},"width":1600,"height":900,"size":102619,"bitrate":0,"public":true,"status":2,"progress":1.0,"metadata":{"av_stream_metadata":"{\"Video\":{}}"},"url":"https://embed-ssl.wistia.com/deliveries/6ef9fef4a05ec0d8d112569c137e8b12.bin","created_at":1678210918}],"branding":false,"createdAt":1678210480,"distilleryUrl":"https://distillery.wistia.com/x","duration":133.32,"enableCustomerLogo":true,"firstEmbedForAccount":false,"firstShareForAccount":false,"hashedId":"3l1x4uy0se","mediaId":101922929,"mediaKey":"wistia-production_101922929","mediaType":"Video","name":"Webflow for Enterprises","preloadPreference":null,"progress":1.0,"protected":false,"projectId":8094320,"seoDescription":"Your website is your greatest asset. Launch tests, experiment with creative, and see results sooner — without relying on developers. Stop gatekeeping your site and unlock world-class speed, scalability, security, and support with Webflow Enterprise. \n\nLearn more today: https://webflow.com/enterprise\n\n----------\nGet started with Webflow: https://wfl.io/2r7cVUW\nJoin the Webflow Community: https://webflow.com/community","showAbout":true,"status":2,"type":"Video","stats":{"loadCount":290794,"playCount":5465,"uniqueLoadCount":207785,"uniquePlayCount":5212,"averageEngagement":0.450201},"trackingTransmitInterval":20,"integrations":{},"captions":[{"language":"eng","text":"I'm seeing a lot of people realize that they can create anything right now. It makes our website look like something that an engineer would do, but one of us actually did it. but one of us actually did it. I had used other CMS sites I had used other CMS sites in the past at previous companies, and Webflow kind of just blew them out of the water.\n\nI view a website as something that is living, it’s not static, I view a website as something that is living, it’s not static, and so keeping it relevant is super important. We switched to Enterprise really for three main reasons. We switched to Enterprise really for three main reasons. One was around scalability of the site.\n\nOne was around scalability of the site. Just as important was security. And the last thing I think is the support. The Enterprise plan for Attentive has been huge.\n\nCreatively, our brand design team, you know, ten people being able to jump in and take part in design and developing pages together, not one person has to be the gatekeeper of that on our team. not one person has to be the gatekeeper of that on our team. It's truly a collaborative effort. Our marketing team wanted to be able to make new pages, new landing pages, faster than every two weeks, every four weeks even.\n\nSo, working in Webflow, we can now push changes like, within a couple hours or bring out a new feature in like a week instead of a month. Webflow brings speed, man. Like, that's something I love about the platform is, enterprise companies, Like, that's something I love about the platform is, enterprise companies, just big companies in general, are gonna to realize how quick they can push things out. are gonna to realize how quick they can push things out.\n\nAnd the quicker you can push things out, the quicker you get results. The CEO or anybody come to us and be like The CEO or anybody come to us and be like “Hey, we want to try this out... and we want to do it like tomorrow... or like right now, or yesterday...” Webflow has been a massive opportunity for us to test out those things really quickly. to test out those things really quickly.\n\nAnd when we are really pushing the boundaries and trying new weird experimental things, which we do like to do, we do have that immediate access to account support and those questions at a moment's notice, which comes in handy quite often. It absolutely blew my mind. It's really great. We're extremely happy customers right now.\n\nYou know, it's exciting to be a part of it. It's exciting to be a developer It's exciting to be a developer and a designer in this day and age, and...\n\nThe future’s with Webflow for sure. The future’s with Webflow for sure."}],"embed_options":{"volumeControl":"true","fullscreenButton":"true","controlsVisibleOnLoad":"false","playerColor":"146ef5","bpbTime":"true","plugin":{"captions-v1":{"language":"","onByDefault":"false","on":"true","async":"true"}},"vulcan":true,"branding":"false","roundedPlayer":"0","showCustomerLogo":"false","unalteredStillImageAsset":{"url":"https://embed-ssl.wistia.com/deliveries/6ef9fef4a05ec0d8d112569c137e8b12.jpg","width":"1600","height":"900"},"thumbnailAltText":"Why Enterprises are using Webflow?","autoPlay":"false","silentAutoPlay":"allow","endVideoBehavior":"reset","playButton":"true","smallPlayButton":"true","playbar":"true","muted":"false","playbackRateControl":"true","qualityControl":"true","audioDescriptionControl":"false"},"embedOptions":{"volumeControl":"true","fullscreenButton":"true","controlsVisibleOnLoad":"false","playerColor":"146ef5","bpbTime":"true","plugin":{"captions-v1":{"language":"","onByDefault":"false","on":"true","async":"true"}},"vulcan":true,"branding":"false","roundedPlayer":"0","showCustomerLogo":"false","unalteredStillImageAsset":{"url":"https://embed-ssl.wistia.com/deliveries/6ef9fef4a05ec0d8d112569c137e8b12.jpg","width":"1600","height":"900"},"thumbnailAltText":"Why Enterprises are using Webflow?","autoPlay":"false","silentAutoPlay":"allow","endVideoBehavior":"reset","playButton":"true","smallPlayButton":"true","playbar":"true","muted":"false","playbackRateControl":"true","qualityControl":"true","audioDescriptionControl":"false"}},"options":{}};
